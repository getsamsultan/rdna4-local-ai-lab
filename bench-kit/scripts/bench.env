# bench.env - edit these once for your machine. Every script reads this file.
MODELS_DIR=$HOME/ods/data/models                 # host folder holding your .gguf files
RESULTS_DIR=$HOME/bench/results                  # where every run gets its own folder
IMAGE=bench-rocm72-patched:b8763                 # bench image (builder stage of the ODS Dockerfile)
UPSTREAM_PORTS="01:00.0 05:00.0 0a:00.0"         # PCIe switch upstream ports above each R9700 (from: lspci -tv)
BENCH_ARGS="-ngl 99 -sm layer -fa 1 -p 512,2048 -n 128 -r 5"   # standard llama-bench settings
STATE_FILE=$HOME/bench/stopped-containers.txt
